<?xml version="1.0" encoding="utf-8"?>
<!-- Family auth, child reports and notification state are intentionally excluded
     from both cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
