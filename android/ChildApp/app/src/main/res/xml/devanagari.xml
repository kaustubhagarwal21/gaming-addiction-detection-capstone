<?xml version="1.0" encoding="utf-8"?>
<!--
  Devanagari consonant page. Exists so Hindi typed in a monitored game reaches the
  capture path: previously Devanagari required a third-party keyboard, whose text is
  only visible to the accessibility service (and not at all in canvas/engine games).
  android:codes carries the Unicode code point; the IME commits it verbatim, so the
  dual-script chat model scores it exactly as it scores accessibility-captured text.
  Page 2 (vowels + matras) is devanagari_vowels.xml; -100 returns to QWERTY.
-->
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="10%p"
    android:keyHeight="46dp"
    android:horizontalGap="0px"
    android:verticalGap="2dp">

    <Row>
        <Key android:codes="2325" android:keyLabel="क" android:keyEdgeFlags="left" />
        <Key android:codes="2326" android:keyLabel="ख" />
        <Key android:codes="2327" android:keyLabel="ग" />
        <Key android:codes="2328" android:keyLabel="घ" />
        <Key android:codes="2330" android:keyLabel="च" />
        <Key android:codes="2331" android:keyLabel="छ" />
        <Key android:codes="2332" android:keyLabel="ज" />
        <Key android:codes="2333" android:keyLabel="झ" />
        <Key android:codes="2335" android:keyLabel="ट" />
        <Key android:codes="2336" android:keyLabel="ठ" android:keyEdgeFlags="right" />
    </Row>

    <Row>
        <Key android:codes="2337" android:keyLabel="ड" android:keyEdgeFlags="left" />
        <Key android:codes="2338" android:keyLabel="ढ" />
        <Key android:codes="2340" android:keyLabel="त" />
        <Key android:codes="2341" android:keyLabel="थ" />
        <Key android:codes="2342" android:keyLabel="द" />
        <Key android:codes="2343" android:keyLabel="ध" />
        <Key android:codes="2344" android:keyLabel="न" />
        <Key android:codes="2346" android:keyLabel="प" />
        <Key android:codes="2347" android:keyLabel="फ" />
