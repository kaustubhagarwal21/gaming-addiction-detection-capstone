        <Key android:codes="2350" android:keyLabel="म" />
        <Key android:codes="2351" android:keyLabel="य" />
        <Key android:codes="2352" android:keyLabel="र" />
        <Key android:codes="2354" android:keyLabel="ल" />
        <Key android:codes="2357" android:keyLabel="व" />
        <Key android:codes="2358" android:keyLabel="श" />
        <Key android:codes="2359" android:keyLabel="ष" />
        <Key android:codes="2360" android:keyLabel="स" />
        <Key android:codes="2361" android:keyLabel="ह" android:keyEdgeFlags="right" />
    </Row>

    <Row>
        <Key android:codes="-101" android:keyLabel="अआ" android:keyWidth="15%p" android:keyEdgeFlags="left" />
        <Key android:codes="2339" android:keyLabel="ण" />
        <Key android:codes="2334" android:keyLabel="ञ" />
        <Key android:codes="2329" android:keyLabel="ङ" />
        <Key android:codes="2355" android:keyLabel="ळ" />
        <Key android:codes="2364" android:keyLabel="़" />
        <Key android:codes="2381" android:keyLabel="्" />
        <Key android:codes="-5" android:keyLabel="⌫" android:keyWidth="15%p" android:isRepeatable="true" android:keyEdgeFlags="right" />
    </Row>

    <Row>
        <Key android:codes="-100" android:keyLabel="ABC"   android:keyWidth="15%p" android:keyEdgeFlags="left" />
        <Key android:codes="2404" android:keyLabel="।"     />
        <Key android:codes="32"   android:keyLabel="space" android:keyWidth="50%p" />
