<?xml version="1.0" encoding="utf-8"?>
<!-- Children's auth and captured wellbeing data must not enter cloud backup or
     device-to-device transfer, even if a future manifest merge changes allowBackup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
