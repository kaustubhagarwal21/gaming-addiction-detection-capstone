<?xml version="1.0" encoding="utf-8"?>
<!--
  Devanagari page 2: independent vowels (row 1) and their matra forms (rows 2-3).
  Matras combine with the preceding consonant when committed, so the IME needs no
  special handling — commitText() of the code point is enough. -102 returns to the
  consonant page, -100 to QWERTY.
-->
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="10%p"
    android:keyHeight="46dp"
    android:horizontalGap="0px"
    android:verticalGap="2dp">

    <Row>
        <Key android:codes="2309" android:keyLabel="अ" android:keyEdgeFlags="left" />
        <Key android:codes="2310" android:keyLabel="आ" />
        <Key android:codes="2311" android:keyLabel="इ" />
        <Key android:codes="2312" android:keyLabel="ई" />
        <Key android:codes="2313" android:keyLabel="उ" />
        <Key android:codes="2314" android:keyLabel="ऊ" />
        <Key android:codes="2319" android:keyLabel="ए" />
        <Key android:codes="2320" android:keyLabel="ऐ" />
        <Key android:codes="2323" android:keyLabel="ओ" />
        <Key android:codes="2324" android:keyLabel="औ" android:keyEdgeFlags="right" />
    </Row>

    <Row>
        <Key android:codes="2366" android:keyLabel="ा" android:keyEdgeFlags="left" />
        <Key android:codes="2367" android:keyLabel="ि" />
        <Key android:codes="2368" android:keyLabel="ी" />
        <Key android:codes="2369" android:keyLabel="ु" />
        <Key android:codes="2370" android:keyLabel="ू" />
        <Key android:codes="2375" android:keyLabel="े" />
        <Key android:codes="2376" android:keyLabel="ै" />
        <Key android:codes="2379" android:keyLabel="ो" />
        <Key android:codes="2380" android:keyLabel="ौ" />
        <Key android:codes="2306" android:keyLabel="ं" android:keyEdgeFlags="right" />
    </Row>

    <Row>
        <Key android:codes="2305" android:keyLabel="ँ" android:keyEdgeFlags="left" />
        <Key android:codes="2307" android:keyLabel="ः" />
        <Key android:codes="2315" android:keyLabel="ऋ" />
        <Key android:codes="2371" android:keyLabel="ृ" />
        <Key android:codes="2317" android:keyLabel="ऍ" />
        <Key android:codes="2321" android:keyLabel="ऑ" />
        <Key android:codes="2384" android:keyLabel="ॐ" />
        <Key android:codes="2365" android:keyLabel="ऽ" />
        <Key android:codes="-5" android:keyLabel="⌫" android:keyWidth="20%p" android:isRepeatable="true" android:keyEdgeFlags="right" />
    </Row>

    <Row>
        <Key android:codes="-102" android:keyLabel="कख"  android:keyWidth="15%p" android:keyEdgeFlags="left" />
        <Key android:codes="-100" android:keyLabel="ABC" android:keyWidth="15%p" />
        <Key android:codes="32"   android:keyLabel="space" android:keyWidth="40%p" />
        <Key android:codes="2404" android:keyLabel="।"   />
        <Key android:codes="10"   android:keyLabel="↵"   android:keyWidth="20%p" android:keyEdgeFlags="right" />
    </Row>
</Keyboard>
